# Supabase Credentials (Isi dari Dashboard Supabase Anda: Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only (HANYA digunakan di server/skrip admin, JANGAN pernah expose ke client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# API Key untuk Chrome Extension Kurasi (POST /api/curation)
CURATION_API_KEY=your_secret_curation_key_here

# Default App Settings
NEXT_PUBLIC_APP_NAME="Dew Theory Affiliate Hub"
NEXT_PUBLIC_DEFAULT_CAMPAIGN="desember-2026"

# Kredensial Seed Pengguna Awal (HANYA untuk scripts/seed-users.mjs, minimal 12 karakter)
# SEED_DINDA_EMAIL=dinda@contoh.com
# SEED_DINDA_PASSWORD=kata_sandi_minimal_12_karakter
# SEED_SURYA_EMAIL=surya@contoh.com
# SEED_SURYA_PASSWORD=kata_sandi_minimal_12_karakter
